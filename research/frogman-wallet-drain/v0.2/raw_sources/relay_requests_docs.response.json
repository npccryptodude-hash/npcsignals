ame\":\"continuation\",\"required\":false,\"description\":\"Pagination cursor returned by a previous response. Pass it back to fetch the next page.\"},\"2d01c741-e40e-4bb5-86cf-f362ca119c91\":{\"schema\":{\"type\":\"string\",\"isRequired\":false,\"description\":\"Filter requests where this address is the sender or recipient.\",\"uniqueKey\":\"\",\"typeLabel\":\"string\"},\"in\":\"query\",\"name\":\"user\",\"required\":false,\"description\":\"Filter requests where this address is the sender or recipient.\"},\"9d260f19-e437-4d43-8d59-e26be45f087d\":{\"schema\":{\"type\":\"string\",\"isRequired\":false,\"description\":\"Filter requests by an origin or destination transaction hash.\",\"uniqueKey\":\"\",\"typeLabel\":\"string\"},\"in\":\"query\",\"name\":\"hash\",\"required\":false,\"description\":\"Filter requests by an origin or destination transaction hash.\"},\"f6614779-3bf9-44de-82b7-ee7c1c0d2e4f\":{\"schema\":{\"type\":\"number\",\"isRequired\":false,\"description\":\"Filter requests where this is the origin chain.\",\"uniqueKey\":\"\",\"typeLabel\":\"number\"},\"in\":\"query\",\"name\":\"originChainId\",\"required\":false,\"description\":\"Filter requests where this is the origin chain.\"},\"439ef6e9-d003-430a-ae21-a92c0e8271af\":{\"schema\":{\"type\":\"number\",\"isRequired\":false,\"description\":\"Filter requests where this is the destination chain. Non-terminal requests are only returned to the API key that created them, or to a dev-portal key of the same integrator.\",\"uniqueKey\":\"\",\"typeLabel\":\"number\"},\"in\":\"query\",\"name\":\"destinationChainId\",\"required\":false,\"description\":\"Filter requests where this is the destination chain. Non-terminal requests are only returned to the API key that created them, or to a dev-portal key of the same integrator.\"},\"e0478689-86fe-4886-b3fb-4b0018dcb621\":{\"schema\":{\"type\":\"string\",\"isRequired\":false,\"description\":\"Comma-separated list of private chain UUIDs to include in the results.\",\"uniq