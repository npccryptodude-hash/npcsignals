@type\":\"FAQPage\",\"author\":{\"@id\":\"https://wagyu.xyz/#organization\"},\"publisher\":{\"@id\":\"https://wagyu.xyz/#organization\"},\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Where can I swap XMR privately?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Choose a supported asset, amount and Monero receiving address on this page. Screening and refund rules are set out in the compliance policy.\"}},{\"@type\":\"Question\",\"name\":\"Can Monero be swapped for Bitcoin?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Send XMR to the deposit address and receive BTC at your Bitcoin address, or the reverse.\"}},{\"@type\":\"Question\",\"name\":\"Can my funds be frozen when converting XMR to BTC?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Screening applies before execution. Failed checks normally enter a refund flow, which can require a refund address and further checks. Legal restrictions described in the compliance policy can affect payouts and refunds.\"}},{\"@type\":\"Question\",\"name\":\"Does Wagyu hold my funds?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Your deposit is swapped and sent to your address, or refunded.\"}},{\"@type\":\"Question\",\"name\":\"What happens if the compliance screening flags my deposit?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Screening runs before execution. A failed check normally enters the refund flow; it can require a refund address and further checks. The compliance policy describes legal restrictions and exceptions.\"}},{\"@type\":\"Question\",\"name\":\"How long does a Monero swap take?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Typical editorial estimates include around 1 minute for USDC to XMR on Arbitrum and around 20 minutes for BTC to XMR, from deposit detection. Your selected network, confirmations and order size can change the timing. The widget estimates your actual swap. Received XMR needs more confirmations before it is spendable.\"}},{\"@type\":\"Question\",\"name\":\"Is there a minimum amount?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"On default networks, SOL to XMR starts at $20, BTC to XMR at $40, and XMR to BTC at $25. The XMR bridge minimum is 0.01 XMR. Check the quote for your selected route.\"}},{\"@type\":\"Question\",\"name\":\"Is Wagyu a DEX?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Not in the strict sense, and we prefer to be precise. Cross-chain routing uses a decentralized aggregator and XMR trades execute on Hyperliquid's decentralized orderbook, but the Monero side of the bridge is operated by Wagyu. What protects you is not a label, it is the design: screening before the swap and automatic refunds.\"}},{\"@type\":\"Question\",\"name\":\"Can I use Wagyu from any country?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Wagyu is available worldwide, except in territories under comprehensive sanctions listed in the compliance policy.\"}},{\"@type\":\"Question\",\"name\":\"Can I buy Monero with a credit card on Wagyu?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Wagyu swaps crypto for crypto. If you are starting from fiat, you need to get your first coins elsewhere and then swap them to XMR here.\"}}]}"])</script><script>self.__next_f.push([1,"2a:[\"$\",\"article\",null,{\"className\":\"mx-auto w-full max-w-5xl space-y-6 px-4 pb-20 pt-16 md:px-6 md:pt-20\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2b\"}}],\"$L2c\",\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\",\"$L31\",\"$L32\",\"$L33\",\"$L34\",\"$L35\"]}]\n"])</script><script>self.__next_f.push([1,"36:I[77623,[\"2250\",\"static/chunks/76330596-c2cb9f6bc1be82aa.js?dpl=dpl_7xhhtym6P8Utmva4X2HczqrG6RRY\",\"3353\",\"static/chunks/5f0715df-991d626187d2b0e1.js?dpl=dpl_7xhhtym6P8Utmva4X2HczqrG6RRY\",\"8021\",\"static/chunks/8021-c93801f6c14337ad.js?dpl=dpl_7xhhtym6P8Utmva4X2HczqrG6RRY\",\"9294\",\"static/chunks/9294-3745fd7e5b0a740f.js?dpl=dpl_7xh